# Identificação do projeto
COMPOSE_PROJECT_NAME=oracle23ai
ORACLE_CONTAINER_NAME=oracle23ai-db
ORACLE_HOSTNAME=oracle23ai-db
ORACLE_VOLUME_NAME=oracle23ai-data
ORACLE_NETWORK_NAME=oracle23ai-net

# Imagem OFICIAL do Oracle Container Registry, fixada na linha 23ai.
# Não use "latest" para este laboratório: atualmente ela pode apontar para 26ai.
ORACLE_IMAGE=container-registry.oracle.com/database/free:23.9.0.0
ORACLE_PLATFORM=linux/amd64

# Rede e recursos
ORACLE_PORT=1521
ORACLE_MEMORY_LIMIT=4g
ORACLE_SHM_SIZE=2g
TZ=America/Maceio

# Parâmetros usados somente na primeira criação do volume.
ORACLE_CHARACTERSET=AL32UTF8
ENABLE_ARCHIVELOG=false
ENABLE_FORCE_LOGGING=false

# Na imagem oficial Free estes nomes NÃO são configuráveis:
# CDB/SID: FREE
# PDB e service name: FREEPDB1

# Administrador local do PDB. Recebe a role DBA dentro do FREEPDB1.
DB_ADMIN_USER=APP_ADMIN

# Proprietário dos objetos do esquema.
DB_SCHEMA_USER=APP_OWNER

# Usuário de runtime, sem privilégios de criação de objetos.
DB_RUNTIME_USER=APP_RUNTIME
DB_RUNTIME_ROLE=APP_RUNTIME_ROLE

# Tablespaces persistidos dentro de /opt/oracle/oradata.
DB_DATA_TABLESPACE=APP_DATA
DB_INDEX_TABLESPACE=APP_INDEX
